  <Table>
   <Column ss:Width="240"/><Column ss:Width="120"/>
   <Row ss:StyleID="Header"><Cell><Data ss:Type="String">Kelompok Pengujian</Data></Cell><Cell><Data ss:Type="String">Jumlah Skenario</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Autentikasi dan Hak Akses</Data></Cell><Cell><Data ss:Type="Number">7</Data></Cell></Row>
   <Row><Cell><Data ss:Type="String">Demo Publik</Data></Cell><Cell><Data ss:Type="Number">3</Data></Cell></Row>
